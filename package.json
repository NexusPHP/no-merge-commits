{
  "name": "no-merge-commits",
  "private": true,
  "version": "2.2.1",
  "description": "Prevent merge commits in pull requests.",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test",
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "vitest --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusPHP/no-merge-commits.git"
  },
  "keywords": [
    "actions",
    "merge commits",
    "pull requests"
  ],
  "author": "John Paul E. Balandan, CPA <paulbalandan@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NexusPHP/no-merge-commits/issues"
  },
  "homepage": "https://github.com/NexusPHP/no-merge-commits#readme",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/tsconfig": "^4.0.0",
    "@types/node": "^25.5.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^10.0.3",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
