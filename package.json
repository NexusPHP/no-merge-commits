{
  "name": "no-merge-commits",
  "private": true,
  "version": "2.4.1",
  "description": "Prevent merge commits in pull requests.",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test",
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "vitest --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusPHP/no-merge-commits.git"
  },
  "keywords": [
    "actions",
    "merge commits",
    "pull requests"
  ],
  "author": "John Paul E. Balandan, CPA <paulbalandan@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NexusPHP/no-merge-commits/issues"
  },
  "homepage": "https://github.com/NexusPHP/no-merge-commits#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/tsconfig": "^4.0.0",
    "@types/node": "^26.1.0",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
