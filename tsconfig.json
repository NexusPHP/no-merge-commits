{
  "extends": "@octokit/tsconfig",
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "esModuleInterop": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*"
  ],
  "compileOnSave": false
}
