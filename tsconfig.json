{
  "extends": "@octokit/tsconfig",
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "module": "Node16",
    "target": "ES2020"
  },
  "include": [
    "src/**/*"
  ],
  "compileOnSave": false
}
